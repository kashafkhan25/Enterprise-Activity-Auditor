# ====================================================================
# UAAS Project Target Exclusions (.gitignore)
# ====================================================================

# 1. Local Telemetry Core Database Folders
# Never upload secret symmetric encryption keys or captured local logs
uaas_data/
*.enc
*.key
*.tmp
*.corrupt

# 2. Python Virtual Environments & Code Caches
# Exclude heavy external library wheels and pre-compiled bytecode tracks
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# 3. OS-Specific Transient Metadata
# Ignore arbitrary background interface parameters generated by Windows/macOS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.directory

# 4. Production Binary Compilation Build Dirs
# Exclude artifacts generated by PyInstaller during the binary build phase
build/
dist/
*.spec

# 5. IDE Project Configurations
# Exclude local editor workspace profiles
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
